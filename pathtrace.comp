#version 450

#define USE_BVH_TREE
#define WORKGROUP_SIZE 32
#define MAX_PATH_LENGTH 5
#define SAMPLE_COUNT 8
#define M_PI 3.141592653589793238462643

layout(local_size_x = WORKGROUP_SIZE, local_size_y = WORKGROUP_SIZE, local_size_z = 1) in;

// code based on the path-tracing workshop at Intel:
// https://www.intel.com/content/www/us/en/developer/videos/path-tracing-workshop-part-1.html

struct Triangle {
    vec3 positions[3];
    vec3 normal;
    vec3 color; // albedo (fraction of light that gets reflected)
    vec3 emission; // radiance emitted by triangle (for light sources)
};

struct BVHNode {
    uint triCount;
    int tris[8];
    uint leftIndex;
    uint rightIndex;
    vec3 boxMin;
    vec3 boxMax;
};

struct Camera {
    vec3 position;
    vec3 target;
    float _; // padding to match C++ layout
    float roll;
    float focalLength;
};

layout(push_constant) uniform constants
{
    uint iTriangleCount;
    uint iFrame;
    ivec2 iResolution;
    Camera camera;
};

layout(std430, binding = 0) buffer mesh
{
    Triangle tris[];
};

layout(std430, binding = 1) buffer bvhTree
{
    BVHNode treeNodes[];
};

layout(std430, binding = 2) buffer prevImage
{
    vec4 prevPixels[];
};

layout(std430, binding = 3) buffer curImage
{
    vec4 pixels[];
};

// used in thousands of ShaderToy shaders
mat3 setCamera(vec3 ro, vec3 ta, float cr) {
    vec3 cw = normalize(ta - ro);                      // Forward
    vec3 cp = vec3(sin(cr), cos(cr), 0.0);             // Roll vector
    vec3 cu = normalize(cross(cw, cp));                // Right
    vec3 cv = cross(cu, cw);                           // Up
    return mat3(cu, cv, cw);
}

// Checks whether a ray intersects a triangle
// \param out_t The ray parameter at the intersection (if any) (t)
// \param origin The position at which the ray starts (o)
// \param direction The direction vector of the ray (d)
// \param tri The triangle for which to check an intersection
// \return true if there is an intersection, false otherwise
bool rayTriangleIntersection(out float out_t, vec3 origin, vec3 direction, Triangle tri) {
    // TODO: Moller-Trumbore should be faster
    vec3 v0 = tri.positions[0];
    mat3 matrix = mat3(-direction, tri.positions[1] - v0, tri.positions[2] - v0);
    vec3 solution = inverse(matrix) * (origin - v0);
    out_t = solution.x;
    vec2 barys = solution.yz;
    return out_t >= 0.0 && barys.x >= 0.0 && barys.y >= 0.0 && barys.x + barys.y <= 1.0;
}

bool intersectAABB(out float out_t, vec3 origin, vec3 direction, vec3 bMin, vec3 bMax)
{
    vec3 tMin = (bMin - origin) / direction;
    vec3 tMax = (bMax - origin) / direction;

    vec3 t1 = min(tMin, tMax);
    vec3 t2 = max(tMin, tMax);

    float tNear = max(max(t1.x, t1.y), t1.z);
    float tFar = min(min(t2.x, t2.y), t2.z);

    out_t = tNear;

    return tNear <= tFar && tFar >= 0.0;
}


// Checks whether a ray intersects any triangle of the mesh
// \param out_t The ray parameter at the closest intersection (if any) (t)
// \param out_tri The closest triangle that was intersected (if any)
// \param origin The position at which the ray starts (o)
// \param direction The direction vector of the ray (d)
// \return true if there is an intersection, false otherwise
bool rayMeshIntersection(out float out_t, out Triangle out_tri, vec3 origin, vec3 direction) {
    // Find the nearest intersection across all triangles
    out_t = 1.0e38;
#ifndef USE_BVH_TREE
    for (int i = 0; i != iTriangleCount; ++i) {
        float t;
        if (rayTriangleIntersection(t, origin, direction, tris[i]) && t < out_t) {
            out_t = t;
            out_tri = tris[i];
        }
    }
#else
    uint stack[20];
    stack[0] = 0;

    uint stackSize = 1;
    while (stackSize > 0) {
        uint nodeIndex = stack[--stackSize];
        BVHNode node = treeNodes[nodeIndex];

        float t;
        if (!intersectAABB(t, origin, direction, node.boxMin, node.boxMax) || t > out_t)
            continue;

        if (node.triCount > 0) {
            // leaf node
            for (uint i = 0; i < node.tris.length(); i++) {
                int triIndex = node.tris[i];
                if (triIndex == -1)
                    break;
                float t;
                if (rayTriangleIntersection(t, origin, direction, tris[triIndex]) && t < out_t) {
                    out_t = t;
                    out_tri = tris[triIndex];
                }
            }
        } else {
            stack[stackSize++] = node.leftIndex;
            stack[stackSize++] = node.rightIndex;
        }
    }
#endif
    return out_t < 1.0e38;
}

// A pseudo-random number generator
// \param seed Numbers that are different for each invocation. Gets updated so
//             that it can be reused.
// \return Two independent, uniform, pseudo-random numbers in [0,1) (u_0, u_1)
vec2 getRandomNumbers(inout uvec2 seed) {
    // This is PCG2D: https://jcgt.org/published/0009/03/02/
    seed = 1664525u * seed + 1013904223u;
    seed.x += 1664525u * seed.y;
    seed.y += 1664525u * seed.x;
    seed ^= (seed >> 16u);
    seed.x += 1664525u * seed.y;
    seed.y += 1664525u * seed.x;
    seed ^= (seed >> 16u);
    // Convert to float. The constant here is 2^-32.
    return vec2(seed) * 2.32830643654e-10;
}


// Given uniform random numbers u_0, u_1 in [0,1)^2, this function returns a
// uniformly distributed point on the unit sphere (i.e. a random direction)
// (omega)
vec3 sampleSphere(vec2 random_numbers) {
    float z = 2.0 * random_numbers[1] - 1.0;
    float phi = 2.0 * M_PI * random_numbers[0];
    float x = cos(phi) * sqrt(1.0 - z * z);
    float y = sin(phi) * sqrt(1.0 - z * z);
    return vec3(x, y, z);
}


// Like sampleSphere() but only samples the hemisphere where the dot product
// with the given normal (n) is >= 0
vec3 sampleHemisphere(vec2 random_numbers, vec3 normal) {
    vec3 direction = sampleSphere(random_numbers);
    if (dot(normal, direction) < 0.0)
        direction -= 2.0 * dot(normal, direction) * normal;
    return direction;
}


// Performs path tracing: It starts with the given ray. If this ray intersects
// a triangle, a new random ray is traced iteratively, up to a fixed limit.
// \param origin The position at which the ray starts (x_j)
// \param direction The direction vector of the ray (omega_j)
// \param seed Needed for getRandomNumbers()
// \return A noisy estimate of the reflected and emitted radiance at the point
//         intersected by the ray (i.e. the color) (L_o(x))
vec3 getRayRadiance(vec3 origin, vec3 direction, inout uvec2 seed) {
    vec3 radiance = vec3(0.0);
    vec3 throughput_weight = vec3(1.0);
    for (int i = 0; i != MAX_PATH_LENGTH; ++i) {
        float t;
        Triangle tri;
        if (rayMeshIntersection(t, tri, origin, direction)) {
            radiance += throughput_weight * tri.emission;
            origin += t * direction;
#if 0
            direction = sampleHemisphere(getRandomNumbers(seed), tri.normal);
            throughput_weight *= tri.color * 2.0 * dot(tri.normal, direction);
#else
            // cosine-weighted sampling
            direction = normalize(tri.normal + sampleSphere(getRandomNumbers(seed)));
            throughput_weight *= tri.color;
#endif
            origin += 1e-5 * direction; // nudge it a bit to fix acne
        }
        else
            break;
    }
    return radiance;
}


vec4 mainImage(in vec2 pixelCoord) {
    // Use a different seed for each pixel and each frame
    uvec2 seed = uvec2(pixelCoord) ^ uvec2(iFrame << 16);

    vec2 uv = (2.0 * (pixelCoord + getRandomNumbers(seed)) - vec2(iResolution)) / float(iResolution.y);

    mat3 invCamera = setCamera(camera.position, camera.target, camera.roll);
    vec3 rayDirection = invCamera * normalize(vec3(uv, camera.focalLength));

    // Perform path tracing with SAMPLE_COUNT paths
    vec4 color;
    color.rgb = vec3(0.0);
    for (int i = 0; i < SAMPLE_COUNT; ++i)
        color.rgb += getRayRadiance(camera.position, rayDirection, seed);
    color.rgb /= float(SAMPLE_COUNT);
    color.a = 1.0;
    return color;
}

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= iResolution.x || y >= iResolution.y)
        return;
    vec4 color = mainImage(vec2(float(x), float(iResolution.y - 1 - y)));
    vec4 prevColor = prevPixels[y * iResolution.x + x];
    float weight = 1.0 / float(iFrame + 1);
    color.rgb = mix(prevColor.rgb, color.rgb, weight);
    pixels[y * iResolution.x + x] = vec4(color.rgb, 1.0);
}
